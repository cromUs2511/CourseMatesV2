# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://my-app.run.app)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Microsoft Entra ID (Azure AD) Institutional OAuth 2.0 Credentials
# 1. Register an App in Microsoft Entra Admin Center (https://entra.microsoft.com)
# 2. Supported account types: "Accounts in any organizational directory (Any Microsoft Entra ID tenant - Multitenant)"
#    or "Accounts in this organizational directory only"
# 3. Add Redirect URI (Web platform): https://<YOUR_APP_DOMAIN>/auth/callback
# 4. Under API Permissions: Ensure "User.Read", "openid", "profile", "email" delegated permissions are granted.
# 5. Under Certificates & Secrets: Create a New Client Secret and paste the VALUE below.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Use "organizations" or "common" (or Mapúa's Directory (tenant) ID)
MICROSOFT_TENANT_ID="organizations"
