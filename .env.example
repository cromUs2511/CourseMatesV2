# Gemini-powered Student Chatbot Assistant, conversation starters, and assistant tools.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Optional chatbot fallback when Gemini is not configured.
GROQ_API_KEY=""
GROQ_MODEL="groq/compound"

# YouTube Data API v3 key for searchable music in chat.
YOUTUBE_API_KEY=""

# Server address. APP_URL is required for sign-in behind an HTTPS proxy.
PORT=3000
HOST="0.0.0.0"
APP_URL=""

# Trusted proxy hops (0 = direct connection, 1-5 behind an HTTPS proxy).
TRUST_PROXY_HOPS=0

# Support contact surfaced by /api/public-config.
SUPPORT_EMAIL=""

# Anonymous access is enabled by default in every environment. Set false only
# when an external gateway prevents public access.
ALLOW_ANONYMOUS_ACCESS=true

# Chat-only two-player games and timestamped shared playback. Set false to
# restore legacy UNO arena endpoints/completion and play/pause-only music.
# Tic-Tac-Toe is unavailable while rolled back; REST chat recovery stays enabled.
CHAT_MULTIPLAYER_V2=true

# Optional Phase-1 Python orchestration shadow service. Disabled by default;
# Node keeps all public behavior and ignores every shadow response.
PYTHON_ORCHESTRATOR_MODE="off"
PYTHON_ORCHESTRATOR_URL="http://127.0.0.1:5051"
PYTHON_ORCHESTRATOR_TIMEOUT_MS="500"

# --- Required only when NODE_ENV=production or `npm start` is used ---
# The process refuses to boot without all of these; see docs/operations.md.
#
# Public HTTPS origin. No path, query, credentials or trailing slash.
# APP_URL="https://coursemates.example"
#
# Ephemeral state lives in one process. Scale-out is refused, not supported.
# SINGLE_INSTANCE="true"
#
# Persistent private volume for the moderation store (moderation.json + moderation.db).
# DATA_DIR="/app/data"
# Optional override for the admin review database file (defaults to DATA_DIR/moderation.db).
# MODERATION_DB_PATH="/app/data/moderation.db"
# Automatic triage score (1-100) at or above which a report is auto-escalated
# for human review. 0 (or off) disables auto-escalation. Never auto-bans.
# AUTO_MOD_ESCALATE_SCORE="80"
#
# Stable random secret of at least 32 characters.
# MODERATION_SECRET=""
# Admin dashboard credentials. Keep the password in a secret manager.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD=""
# Number of trusted proxies in front of the app (Render: 1; direct access: 0).
# TRUST_PROXY_HOPS="1"
