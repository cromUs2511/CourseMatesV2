# Gemini-powered Student Chatbot Assistant, conversation starters, and assistant tools.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Optional chatbot fallback when Gemini is not configured.
GROQ_API_KEY=""
GROQ_MODEL="groq/compound"

# YouTube Data API v3 key for searchable music in chat.
YOUTUBE_API_KEY=""

# Server address. APP_URL is required for sign-in behind an HTTPS proxy.
PORT=3000
HOST="0.0.0.0"
APP_URL=""

# Set true only for a demonstration. Default: true in dev, false in production.
# ALLOW_DEMO_LOGIN=false

# Microsoft school-account sign-in. Register APP_URL/auth/callback as a Web URI.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="organizations"
