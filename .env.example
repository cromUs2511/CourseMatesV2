# Optional AI conversation starters. Blank uses local suggestions.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Server address. APP_URL is required for sign-in behind an HTTPS proxy.
PORT=3000
HOST="0.0.0.0"
APP_URL=""

# Set true only for a demonstration. Default: true in dev, false in production.
# ALLOW_DEMO_LOGIN=false

# Microsoft school-account sign-in. Register APP_URL/auth/callback as a Web URI.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="organizations"
